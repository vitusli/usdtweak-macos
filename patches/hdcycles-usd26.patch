diff --git a/intern/cycles/hydra/material.cpp b/intern/cycles/hydra/material.cpp
index 3b9919f7..c72e3d06 100644
--- a/intern/cycles/hydra/material.cpp
+++ b/intern/cycles/hydra/material.cpp
@@ -579,6 +579,10 @@ void HdCyclesMaterial::Initialize(HdRenderParam *renderParam)
   const SceneLock lock(renderParam);
 
   _shader = lock.scene->create_node<Shader>();
+  /* Ensure shader always has a valid graph, even before material network is synced.
+   * Cycles internals (ShaderManager::device_update_pre, Shader::tag_update) assume
+   * graph is never null. */
+  _shader->set_graph(make_unique<ShaderGraph>());
 }
 
 HDCYCLES_NAMESPACE_CLOSE_SCOPE
diff --git a/intern/cycles/hydra/render_delegate.cpp b/intern/cycles/hydra/render_delegate.cpp
index ea3dae98..26e615c5 100644
--- a/intern/cycles/hydra/render_delegate.cpp
+++ b/intern/cycles/hydra/render_delegate.cpp
@@ -311,4 +311,7 @@ TfToken HdCyclesDelegate::GetMaterialBindingPurpose() const
 TfTokenVector HdCyclesDelegate::GetMaterialRenderContexts() const
 {
-  return {_tokens->cycles};
+  /* Include the universal render context (empty token) so that
+   * UsdPreviewSurface materials are picked up in addition to
+   * Cycles-specific material networks. */
+  return {_tokens->cycles, TfToken()};
 }
