+/* Resolve a package-relative asset path (e.g. inside .usdz) by extracting
+ * the asset data via ArResolver and caching it to a temporary file on disk.
+ * Returns the path to the extracted file, or empty string on failure. */
+std::string resolvePackageAsset(const std::string &resolvedPath)
+{
+  namespace fs = std::filesystem;
+
+  std::string cacheDir = (fs::temp_directory_path() / "hdCycles_texcache").string();
+  fs::create_directories(cacheDir);
+
+  /* Use a hash of the full resolved path as filename, preserving extension */
+  size_t pathHash = std::hash<std::string>{}(resolvedPath);
+  std::string ext = TfGetExtension(resolvedPath);
+  if (ext.empty()) {
+    std::string innerPath = ArSplitPackageRelativePathInner(resolvedPath).second;
+    ext = TfGetExtension(innerPath);
+  }
+  std::string cachedFile = cacheDir + "/" + std::to_string(pathHash);
+  if (!ext.empty()) {
+    cachedFile += "." + ext;
+  }
+
+  /* If already cached, return immediately */
+  if (fs::exists(cachedFile)) {
+    return cachedFile;
+  }
+
+  /* Open the asset through the ArResolver (handles .usdz packages) */
+  ArResolver &resolver = ArGetResolver();
+  std::shared_ptr<ArAsset> asset = resolver.OpenAsset(ArResolvedPath(resolvedPath));
+  if (!asset) {
+    TF_WARN("hdCycles: failed to open packaged asset: %s", resolvedPath.c_str());
+    return std::string();
+  }
+
+  /* Read asset data and write to cache file */
+  std::shared_ptr<const char> buffer = asset->GetBuffer();
+  size_t size = asset->GetSize();
+  std::ofstream out(cachedFile, std::ios::binary);
+  if (!out || !buffer) {
+    TF_WARN("hdCycles: failed to extract packaged asset: %s", resolvedPath.c_str());
+    return std::string();
+  }
+  out.write(buffer.get(), size);
+  return cachedFile;
+}
